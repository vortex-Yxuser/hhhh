<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D0D0D"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="HHHH SSH VPN Pro"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold"
            android:gravity="center"
            android:paddingBottom="8dp" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="○ Disconnected"
            android:textColor="#EF5350"
            android:textSize="16sp"
            android:gravity="center"
            android:paddingBottom="12dp" />

        <!-- SSH Section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SSH Server"
            android:textColor="#90CAF9"
            android:textStyle="bold"
            android:paddingTop="4dp" />

        <EditText
            android:id="@+id/etHost"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Host / IP"
            android:inputType="text"
            android:textColor="#FFFFFF"
            android:textColorHint="#666666"
            android:backgroundTint="#333333" />

        <EditText
            android:id="@+id/etPort"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Port (22)"
            android:inputType="number"
            android:textColor="#FFFFFF"
            android:textColorHint="#666666"
            android:backgroundTint="#333333" />

        <EditText
            android:id="@+id/etUser"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Username"
            android:inputType="text"
            android:textColor="#FFFFFF"
            android:textColorHint="#666666"
            android:backgroundTint="#333333" />

        <EditText
            android:id="@+id/etPass"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Password"
            android:inputType="textPassword"
            android:textColor="#FFFFFF"
            android:textColorHint="#666666"
            android:backgroundTint="#333333" />

        <!-- Payload -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Payload Preset"
            android:textColor="#90CAF9"
            android:textStyle="bold"
            android:paddingTop="12dp" />

        <Spinner
            android:id="@+id/spPreset"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#1A1A1A"
            android:popupBackground="#222222" />

        <EditText
            android:id="@+id/etPayload"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:hint="Payload (use [host] [host_port] [crlf])"
            android:inputType="textMultiLine"
            android:gravity="top"
            android:textColor="#FFFFFF"
            android:textColorHint="#666666"
            android:backgroundTint="#333333"
            android:textSize="12sp" />

        <!-- Proxy -->
        <CheckBox
            android:id="@+id/cbProxy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Use intermediate Proxy"
            android:textColor="#FFFFFF"
            android:paddingTop="8dp" />

        <EditText
            android:id="@+id/etProxyHost"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Proxy Host"
            android:inputType="text"
            android:textColor="#FFFFFF"
            android:textColorHint="#666666"
            android:backgroundTint="#333333" />

        <EditText
            android:id="@+id/etProxyPort"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Proxy Port"
            android:inputType="number"
            android:textColor="#FFFFFF"
            android:textColorHint="#666666"
            android:backgroundTint="#333333" />

        <!-- Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="16dp">

            <Button
                android:id="@+id/btnConnect"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="CONNECT"
                android:backgroundTint="#1B5E20"
                android:textColor="#FFFFFF"
                android:layout_marginEnd="6dp" />

            <Button
                android:id="@+id/btnDisconnect"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="DISCONNECT"
                android:backgroundTint="#B71C1C"
                android:textColor="#FFFFFF"
                android:layout_marginStart="6dp"
                android:enabled="false" />
        </LinearLayout>

        <Button
            android:id="@+id/btnClearLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Clear Logs"
            android:backgroundTint="#333333"
            android:textColor="#AAAAAA"
            android:layout_marginTop="8dp" />

        <!-- Logs -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Live Logs (stable)"
            android:textColor="#90CAF9"
            android:textStyle="bold"
            android:paddingTop="12dp" />

        <TextView
            android:id="@+id/tvLogs"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:background="#111111"
            android:textColor="#B0BEC5"
            android:textSize="11sp"
            android:padding="8dp"
            android:scrollbars="vertical"
            android:fadeScrollbars="false"
            android:fontFamily="monospace" />

    </LinearLayout>
</ScrollView>
