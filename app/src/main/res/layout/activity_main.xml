<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B0B0F">

    <!-- Main Content -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="20dp"
        android:gravity="center_horizontal">

        <!-- Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Yohan VPN Pro"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="6dp" />

        <!-- Status Pill -->
        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Disconnected"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:background="@drawable/status_pill_disconnected"
            android:paddingHorizontal="20dp"
            android:paddingVertical="6dp"
            android:layout_marginBottom="12dp" />

        <!-- Live Stats (Timer & Speed) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="#16161C"
            android:padding="10dp"
            android:layout_marginBottom="14dp"
            android:gravity="center"
            android:elevation="2dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center">
                <TextView
                    android:text="Connection Time"
                    android:textColor="#888888"
                    android:textSize="11sp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <TextView
                    android:id="@+id/tvTimer"
                    android:text="00:00:00"
                    android:textColor="#4ADE80"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>

            <View
                android:layout_width="1dp"
                android:layout_height="25dp"
                android:background="#333333"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center">
                <TextView
                    android:text="Speed"
                    android:textColor="#888888"
                    android:textSize="11sp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <TextView
                    android:id="@+id/tvSpeed"
                    android:text="↓ 0 KB/s  ↑ 0 KB/s"
                    android:textColor="#38BDF8"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
        </LinearLayout>

        <!-- SSH Account Card -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SSH Account"
            android:textColor="#A0A0A0"
            android:textSize="13sp"
            android:layout_marginBottom="6dp" />

        <EditText
            android:id="@+id/etHost"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:hint="Host / IP"
            android:inputType="text"
            android:textColor="#FFFFFF"
            android:textColorHint="#555555"
            android:background="@drawable/edit_bg"
            android:paddingHorizontal="14dp"
            android:layout_marginBottom="6dp"
            android:singleLine="true" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="6dp">

            <EditText
                android:id="@+id/etPort"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:hint="Port"
                android:inputType="number"
                android:textColor="#FFFFFF"
                android:textColorHint="#555555"
                android:background="@drawable/edit_bg"
                android:paddingHorizontal="14dp"
                android:layout_marginEnd="6dp"
                android:singleLine="true"
                android:text="22" />

            <EditText
                android:id="@+id/etUser"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="2"
                android:hint="Username"
                android:inputType="text"
                android:textColor="#FFFFFF"
                android:textColorHint="#555555"
                android:background="@drawable/edit_bg"
                android:paddingHorizontal="14dp"
                android:layout_marginStart="6dp"
                android:singleLine="true" />
        </LinearLayout>

        <EditText
            android:id="@+id/etPass"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:hint="Password"
            android:inputType="textPassword"
            android:textColor="#FFFFFF"
            android:textColorHint="#555555"
            android:background="@drawable/edit_bg"
            android:paddingHorizontal="14dp"
            android:layout_marginBottom="10dp"
            android:singleLine="true" />

        <!-- Mode Spinner -->
        <Spinner
            android:id="@+id/spPreset"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="@drawable/edit_bg"
            android:popupBackground="#1C1C22"
            android:layout_marginBottom="14dp" />

        <!-- Single Toggle Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnToggle"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="CONNECT"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            app:backgroundTint="#7C4DFF"
            app:cornerRadius="16dp"
            android:layout_marginBottom="14dp" />

        <!-- Pull to show logs hint -->
        <TextView
            android:id="@+id/tvLogsHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="▲  SSH Logs  ▲"
            android:textColor="#666666"
            android:textSize="13sp"
            android:padding="6dp" />

    </LinearLayout>

    <!-- Bottom Sheet for Logs -->
    <LinearLayout
        android:id="@+id/logsPanel"
        android:layout_width="match_parent"
        android:layout_height="320dp"
        android:orientation="vertical"
        android:background="@drawable/logs_panel_bg"
        android:elevation="16dp"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior"
        app:behavior_peekHeight="48dp"
        app:behavior_hideable="false">

        <!-- Handle -->
        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:background="#444444"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SSH Logs"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="15sp"
            android:gravity="center"
            android:paddingBottom="8dp" />

        <TextView
            android:id="@+id/tvLogs"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="#00000000"
            android:textColor="#B0BEC5"
            android:textSize="12sp"
            android:padding="12dp"
            android:scrollbars="vertical"
            android:fontFamily="monospace"
            android:lineSpacingExtra="2dp" />

        <Button
            android:id="@+id/btnClearLog"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:text="Clear Logs"
            android:textColor="#AAAAAA"
            android:backgroundTint="#1A1A1A"
            android:layout_margin="8dp" />
    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
