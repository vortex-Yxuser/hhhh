<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- iOS Style Toolbar -->
        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="#000000"
            app:title="Yohan VPN Pro"
            app:titleTextColor="#FFFFFF"
            app:titleCentered="true" />

        <!-- Scrollable Content -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal">

                <!-- Connection Card / Pill (iOS Style) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/ios_card_bg"
                    android:padding="16dp"
                    android:layout_marginBottom="16dp"
                    android:gravity="center">

                    <TextView
                        android:id="@+id/tvStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Disconnected"
                        android:textColor="#FF453A"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="12dp" />

                    <!-- Stats Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:background="#1C1C1E"
                        android:padding="10dp"
                        android:layout_marginBottom="16dp"
                        android:elevation="0dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:gravity="center">
                            <TextView
                                android:text="Time"
                                android:textColor="#8E8E93"
                                android:textSize="11sp"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"/>
                            <TextView
                                android:id="@+id/tvTimer"
                                android:text="00:00:00"
                                android:textColor="#32D74B"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"/>
                        </LinearLayout>

                        <View
                            android:layout_width="1dp"
                            android:layout_height="24dp"
                            android:background="#38383A"/>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:gravity="center">
                            <TextView
                                android:text="Speed"
                                android:textColor="#8E8E93"
                                android:textSize="11sp"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"/>
                            <TextView
                                android:id="@+id/tvSpeed"
                                android:text="↓ 0 KB/s  ↑ 0 KB/s"
                                android:textColor="#0A84FF"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"/>
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Big iOS Connect Button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnToggle"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:text="CONNECT"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        app:backgroundTint="#0A84FF"
                        app:cornerRadius="25dp" />
                </LinearLayout>

                <!-- SSH Settings Section (iOS Grouped Style) -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    text="SSH CONFIGURATION"
                    android:textColor="#8E8E93"
                    android:textSize="12sp"
                    android:layout_marginStart="12dp"
                    android:layout_marginBottom="6dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/ios_card_bg"
                    android:padding="16dp"
                    android:layout_marginBottom="16dp">

                    <EditText
                        android:id="@+id/etHost"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:hint="Host / IP"
                        android:inputType="text"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#48484A"
                        android:background="@drawable/ios_input_bg"
                        android:paddingHorizontal="12dp"
                        android:layout_marginBottom="10dp"
                        android:singleLine="true" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="10dp">

                        <EditText
                            android:id="@+id/etPort"
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_weight="1"
                            android:hint="Port"
                            android:inputType="number"
                            android:textColor="#FFFFFF"
                            android:textColorHint="#48484A"
                            android:background="@drawable/ios_input_bg"
                            android:paddingHorizontal="12dp"
                            android:layout_marginEnd="6dp"
                            android:singleLine="true"
                            android:text="22" />

                        <EditText
                            android:id="@+id/etUser"
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_weight="2"
                            android:hint="Username"
                            android:inputType="text"
                            android:textColor="#FFFFFF"
                            android:textColorHint="#48484A"
                            android:background="@drawable/ios_input_bg"
                            android:paddingHorizontal="12dp"
                            android:layout_marginStart="6dp"
                            android:singleLine="true" />
                    </LinearLayout>

                    <EditText
                        android:id="@+id/etPass"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:hint="Password"
                        android:inputType="textPassword"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#48484A"
                        android:background="@drawable/ios_input_bg"
                        android:paddingHorizontal="12dp"
                        android:layout_marginBottom="10dp"
                        android:singleLine="true" />

                    <!-- Payload Spinner iOS style -->
                    <Spinner
                        android:id="@+id/spPreset"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:background="@drawable/ios_input_bg"
                        android:popupBackground="#1C1C1E" />
                </LinearLayout>

            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <!-- Bottom Sheet for Logs -->
    <LinearLayout
        android:id="@+id/logsPanel"
        android:layout_width="match_parent"
        android:layout_height="320dp"
        android:orientation="vertical"
        android:background="@drawable/ios_sheet_bg"
        android:elevation="16dp"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior"
        app:behavior_peekHeight="48dp"
        app:behavior_hideable="false">

        <!-- Handle -->
        <View
            android:layout_width="36dp"
            android:layout_height="4dp"
            android:background="#48484A"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SSH Logs"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="15sp"
            android:gravity="center"
            android:paddingBottom="8dp" />

        <TextView
            android:id="@+id/tvLogs"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="#00000000"
            android:textColor="#32D74B"
            android:textSize="12sp"
            android:padding="12dp"
            android:scrollbars="vertical"
            android:fontFamily="monospace"
            android:lineSpacingExtra="2dp" />

        <Button
            android:id="@+id/btnClearLog"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:text="Clear Logs"
            android:textColor="#0A84FF"
            android:backgroundTint="#1C1C1E"
            android:layout_margin="8dp" />
    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
